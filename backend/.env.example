NODE_ENV=development
HOST=0.0.0.0
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/chauffeurBooking
JWT_SECRET=change-this-secret
JWT_REFRESH_SECRET=change-this-refresh-secret
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=30d
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Optional Cloudinary upload storage. If these are missing, uploads safely fall back to local /uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=bjed-chauffeur

# Optional Firebase Admin SDK credentials. Get these from Firebase Console > Project settings > Service accounts.
FIREBASE_PROJECT_ID=b-jed-chauffeur
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-service-account-private-key\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY_BASE64=
FIREBASE_STORAGE_BUCKET=b-jed-chauffeur.firebasestorage.app

# Optional WebRTC ICE/TURN config for in-app audio calls.
# STUN is enough for local/Wi-Fi testing, but TURN is needed for reliable calls on mobile networks.
ICE_STUN_URLS=stun:stun.l.google.com:19302,stun:global.stun.twilio.com:3478
TURN_URLS=turn:your-turn-domain.com:3478?transport=udp,turn:your-turn-domain.com:3478?transport=tcp,turns:your-turn-domain.com:5349?transport=tcp

# Use either static TURN credentials from your provider:
TURN_USERNAME=
TURN_CREDENTIAL=

# Or a coturn REST API shared secret for temporary credentials:
TURN_SHARED_SECRET=
TURN_TTL_SECONDS=3600
